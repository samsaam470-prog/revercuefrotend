import { ReactNode } from 'react';

export interface {{NAME}}Props {
  children?: ReactNode;
  className?: string;
  variant?: string;
  disabled?: boolean;
  loading?: boolean;
}

export function {{NAME}}({ children, className = '', variant = 'default', disabled = false, loading = false }: {{NAME}}Props) {
  const classes = ['{{CSS_CLASS}}', `variant-${variant}`, className, disabled ? 'is-disabled' : '', loading ? 'is-loading' : ''].filter(Boolean).join(' ');
  return (
    <div className={classes} data-variant={variant} aria-disabled={disabled}>
      {loading ? <span className="spinner" /> : children}
    </div>
  );
}
