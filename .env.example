# The Revercue API. Set this in Cloudflare Pages for every environment.
VITE_API_BASE_URL=https://revercue-api.samsaam470.workers.dev

# Google sign-in. Leave empty to hide the button gracefully.
VITE_GOOGLE_CLIENT_ID=

# Social links. Leave empty and the footer omits that icon.
VITE_X_URL=
VITE_IG_URL=
VITE_FB_URL=
VITE_THREADS_URL=
VITE_YT_URL=

# The four "Explain Revercue with" buttons. Paste the COMPLETE URL including
# the prompt, encoded. The value is used byte-for-byte as the href: the frontend
# never builds, appends or rewrites it, so the prompt can be changed in the
# host's environment without touching the code.
# Example: VITE_CHATGPT_PROMPT_URL=https://chatgpt.com/?q=Explain%20Revercue%3A%20...
VITE_CHATGPT_PROMPT_URL=
VITE_PERPLEXITY_PROMPT_URL=
VITE_CLAUDE_PROMPT_URL=
VITE_GEMINI_PROMPT_URL=

# AuthAction (authentication provider). Defaults are baked into the app; override only if needed.
VITE_AUTHACTION_DOMAIN=revercue.in.authaction.com
VITE_AUTHACTION_CLIENT_ID=6afa55be765d68ab52b7acee
VITE_AUTHACTION_AUDIENCE=revercue-api.samsaam470.workers.dev
