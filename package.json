{
  "name": "revercue-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/export-content.mjs && node scripts/export-pages.mjs && node scripts/prerender-seo.mjs && node scripts/prerender-blog.mjs && node scripts/flatten-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prerender:seo": "node scripts/prerender-seo.mjs",
    "prerender:blog": "node scripts/prerender-blog.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@authaction/web-sdk": "^0.1.8",
    "@mlc-ai/web-llm": "^0.2.88",
    "@tanstack/react-query": "^5.59.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
